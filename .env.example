# ============================================================
# VaultClaw / AIRS - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Only OPENAI_API_KEY is required if you use the OpenAI provider.
# All other values have working defaults for local Docker Compose.
# ============================================================

# --- LLM Provider -------------------------------------------
# Set OPENAI_API_KEY to enable the OpenAI provider.
# Leave empty to use the default local Ollama model.
OPENAI_API_KEY=

# --- Grafana ---------------------------------------------------
# Grafana admin credentials (defaults: admin / admin)
# GF_SECURITY_ADMIN_USER=admin
# GF_SECURITY_ADMIN_PASSWORD=changeme

# --- OpenSearch ------------------------------------------------
# Only needed if you change the default single-node setup.
# OPENSEARCH_INITIAL_ADMIN_PASSWORD=Admin1234!

# --- Next.js UI ------------------------------------------------
# Points the browser at the API gateway.
# Change this if you expose the gateway on a different host/port.
NEXT_PUBLIC_API_BASE=http://localhost:8000
